# --- Django Core Settings ---
SECRET_KEY=change-this-secret-key-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
SECURE_SSL_REDIRECT=False
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8081,http://localhost:19006

# --- Database Settings (Leave blank to use local sqlite3, or set DATABASE_URL / DB_NAME) ---
DATABASE_URL=
DB_NAME=
DB_USER=
DB_PASS=
DB_HOST=localhost
DB_PORT=5432

# --- Payment Gateway & Pix EMV Settings ---
PAYMENT_WEBHOOK_SECRET=change-this-webhook-secret
PIX_MERCHANT_KEY=pagamentos@inwallet.app
PIX_MERCHANT_CITY=SAO PAULO

# --- SMTP Email Settings (Optional - falls back to console in dev) ---
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=InWallet <noreply@inwallet.app>
